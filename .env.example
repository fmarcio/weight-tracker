# ==============================================================================
# ENVIRONMENT VARIABLES EXAMPLE (.env.example)
# ==============================================================================
# Copy this file to `.env.local` for local development.
# NEVER commit `.env.local` or any actual keys to Git!
#
# 💡 NEXT.JS ENVIRONMENT VARIABLE RULES:
# 1. Variables starting with `NEXT_PUBLIC_` are exposed to the browser.
#    Example: Firebase Client SDK configuration keys.
# 2. Variables WITHOUT `NEXT_PUBLIC_` are strictly private to the server.
#    Example: Database admin secrets, private API tokens.
# ==============================================================================

# Firebase Web App Client Config (Exposed to browser via NEXT_PUBLIC_)
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Server-only secrets (Never exposed to browser)
# FIREBASE_ADMIN_PRIVATE_KEY=your_private_key_here
